{
  "name": "group-deal-contracts",
  "version": "1.0.0",
  "description": "Smart contracts for GroupDeal on Arc Testnet",
  "scripts": {
    "compile": "hardhat compile",
    "compile:local": "node ../scripts/run_contract_checks.cjs compile",
    "test": "hardhat test",
    "test:stateful": "node ../scripts/run_contract_checks.cjs fuzz",
    "test:projection": "node ../scripts/run_contract_checks.cjs projection",
    "test:concurrency": "node ../scripts/run_contract_checks.cjs concurrency",
    "test:gas": "node ../scripts/run_contract_checks.cjs gas",
    "test:local": "node ../scripts/run_contract_checks.cjs all",
    "test:types": "node ../scripts/run_contract_checks.cjs types",
    "create:security-multisig": "hardhat run scripts/create_security_multisig.ts --network arcTestnet",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:arc": "hardhat run scripts/deploy.ts --network arcTestnet",
    "node": "hardhat node"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.0.2",
    "@safe-global/protocol-kit": "^8.0.7",
    "@safe-global/safe-deployments": "^1.37.63",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.18",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
