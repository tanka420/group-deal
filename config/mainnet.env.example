# Preparation only. Do not start services until the exact release scope is approved.
APP_ENV=arc-mainnet
ARC_CHAIN_ID=5042
PORT=4100
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_WS_URL=wss://rpc.blockdaemon.mainnet.arc.io/websocket
ARC_RPC_FALLBACKS=https://rpc.blockdaemon.mainnet.arc.io,https://rpc.drpc.mainnet.arc.io,https://rpc.quicknode.mainnet.arc.io
# Pin Hub, runtime hash, deployment receipt/block, protocol and all roles in
# shared/manifests/arc-mainnet.json after owner deployment and readback.
GROUPDEAL_HUB_ADDRESS=
USDC_ADDRESS=0x3600000000000000000000000000000000000000
DEPLOYMENT_BLOCK=
OPERATOR_ADDRESS=
JWT_SECRET=
CAMPAIGN_IDENTITY_SECRET=
MASTER_ENCRYPTION_KEY=
MASTER_ENCRYPTION_KEY_ID=mainnet-v1
AUTHORIZED_SIGNER_PRIVATE_KEY=
CIRCLE_API_KEY=
CIRCLE_BASE_URL=https://api.circle.com
PUBLIC_APP_URL=
ALLOWED_ORIGINS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=
# Frontend public build parameters, separate from backend credentials.
VITE_APP_ENV=arc-mainnet
VITE_CIRCLE_APP_ID=
VITE_REOWN_PROJECT_ID=
GROUPDEAL_API_PROXY=http://127.0.0.1:4100
