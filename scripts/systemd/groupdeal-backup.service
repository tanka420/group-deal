[Unit]
Description=GroupDeal read-only online encrypted backup and isolated restore verification
After=groupdeal-testnet.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
UMask=0077
ExecStart=/usr/bin/flock --nonblock /home/ubuntu/groupdeal/operations/backups/backup.lock /home/ubuntu/groupdeal-runtime/node-v24.21.0-linux-x64/bin/node /home/ubuntu/groupdeal/operations/hosted_backup.cjs --app-root /home/ubuntu/groupdeal/releases/47d853f79ff5c2b1c8ac7f0f8163ca613fb82d9a --state-directory /home/ubuntu/groupdeal/operations/backups
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/groupdeal/operations/backups
RestrictAddressFamilies=AF_UNIX
SyslogIdentifier=groupdeal-backup
