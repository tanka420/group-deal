# Arc Testnet deployment configuration. Copy to .env; never commit the real file.
ARC_TESTNET_RPC=https://rpc.testnet.arc.io
DEPLOYER_PRIVATE_KEY=replace-with-owner-deployer-private-key
OPERATOR_ADDRESS=0xe48b30ea70f77e5fa6311471c2e9687f8a701ead
AUTHORIZED_SIGNER_ADDRESS=0xc9691f85f149e71c4e1c14c6e6204128546eef17

# Must be a deployed 2-of-3 multisig contract. An EOA or EIP-7702 delegated account is rejected.
SECURITY_MULTISIG_ADDRESS=0xdDB2458855170cd4A0eF5aff1f65A78782Ca72e6

# Required only with `npm run cleanup:arc-legacy -- --execute`.
# Leave unset for the default read-only preflight.
ALLOW_LEGACY_CLEANUP=

# `test:arc-live` is contract-primitives only and additionally requires
# AUTHORIZED_SIGNER_PRIVATE_KEY in backend/.env plus this exact one-run acknowledgment.
# Do not enable it for ordinary test/pipeline runs.
ALLOW_ARC_CONTRACT_PRIMITIVE_JOURNEY=
