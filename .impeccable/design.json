  "narrative": {
    "northStar": "The Clear Product Shelf",
    "overview": "Give the product and buying decision room to be understood: real catalog items lead, with price, availability, delivery, and license details nearby. The shared buyer language is open and calm: white static surfaces, navy text, cobalt actions, fine dividers, and restrained status colors.\n\nBe Vietnam Pro supports English and Vietnamese. Catalog images come from product data and use a labeled fallback when unavailable. Seller and operator workspaces are outside this .storefront-app system.",
    "keyCharacteristics": [
      "Product-led hierarchy with current catalog content.",
      "Spacious white surfaces with navy text and cobalt actions.",
      "Compact semantic status colors and fine dividers.",
      "Bilingual typography and static backgrounds."
    ],
    "rules": [
      {
        "name": "The Quiet Status Rule",
        "body": "Green and slate badges describe actual product or purchase states; they are not decoration.",
        "section": "colors"
      },
      {
        "name": "The Two-Language Rule",
        "body": "Keep the same hierarchy in both languages; do not shrink or truncate Vietnamese labels to make layouts fit.",
        "section": "typography"
      },
      {
        "name": "The Product-First Rule",
        "body": "Lead with the real product, title, current price, and status; keep the complete license and delivery details reachable from it.",
        "section": "layout"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Do not add ambient shadows to product tiles, galleries, or the purchase panel.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use real product imagery and the labeled fallback; keep price, rights, license, and delivery attached to that product.",
      "Do preserve English/Vietnamese and visible Arc Testnet and USDC context."
    ],
    "donts": [
      "Don't invent live products, sales, testimonials, or rights-approval states.",
      "Don't add moving or repeating perspective grids, or bypass the existing financial and transaction flows."
    ]
  }
