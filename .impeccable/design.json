      "html": "<label class=\"ds-search\">Search products<input type=\"search\" /></label>",
      "css": ".ds-search{display:grid;gap:8px;font:500 13px var(--font-body)}.ds-search input{min-height:48px;padding:10px 14px;border:1px solid var(--border-medium);border-radius:8px;background:var(--bg-primary);font:400 14px/1.7 var(--font-body)}.ds-search input:focus-visible{outline:3px solid var(--primary);outline-offset:4px}"
    },
