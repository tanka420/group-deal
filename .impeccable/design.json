      "html": "<button class=\"ds-primary\">Join group</button>",
      "css": ".ds-primary{font:600 13px var(--font-body);min-height:46px;padding:10px 18px;border:1px solid var(--primary);border-radius:8px;background:var(--primary);color:white;transition:background-color .15s}.ds-primary:hover{background:var(--primary-dark)}.ds-primary:focus-visible{outline:3px solid var(--primary);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
