      "html": "<article class=\"ds-product\"><div>Product image</div><h3>Product title</h3><p>Current price and progress</p><details><summary>License and delivery</summary><p>Terms from catalog data.</p></details></article>",
      "css": ".ds-product{font-family:var(--font-body);color:var(--text-primary)}.ds-product>div{height:250px;display:grid;place-items:center;background:#f0f4fa}.ds-product h3{font-size:20px;font-weight:600;line-height:1.4}.ds-product details{padding-top:10px;border-top:1px solid var(--border-subtle);font-size:12px}.ds-product summary{min-height:36px;cursor:pointer}"
