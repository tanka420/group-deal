{
  "name": "group-deal",
  "version": "1.0.0",
  "description": "GroupDeal - Group buying for digital goods on Arc Testnet",
  "scripts": {
    "clean": "node scripts/clean.cjs",
    "compile": "node scripts/compile_contracts.cjs",
    "test:contracts": "node scripts/test_contracts.cjs",
    "test:backend": "npm --prefix backend test",
    "test": "npm run test:contracts && npm run test:backend",
    "test:arc-smoke": "node scripts/arc_probe.cjs",
    "build:sdk": "npm --prefix backend exec -- tsc -p ./sdk/tsconfig.json",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "typecheck": "npm --prefix backend run typecheck && npm --prefix frontend run typecheck",
    "verify:pipeline": "node scripts/pipeline_verification.cjs",
    "deploy:local": "npm --prefix contracts run deploy:local",
    "deploy:arc": "npm --prefix contracts run deploy:arc",
    "test:arc-live": "npm --prefix backend exec -- tsx ../scripts/arc_live_journey.ts",
    "seed:local": "cd contracts && npx hardhat run scripts/seed_demo.ts --network localhost"
  },
  "keywords": [
    "arc-testnet",
    "groupdeal",
    "smart-contracts",
    "usdc",
    "group-buying"
  ],
  "author": "GroupDeal Team",
  "license": "MIT"
}
