NODE_ENV=development
PORT=4000

# Arc Testnet
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_WS_URL=wss://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
GROUPDEAL_HUB_ADDRESS=0x2A7aECd1CE90f1284EB060488c8dDEF4b1bE0574
USDC_ADDRESS=0x3600000000000000000000000000000000000000
DEPLOYMENT_BLOCK=64644317
EXPLORER_URL=https://testnet.arcscan.app

# Generate unique secrets; never commit real values.
JWT_SECRET=replace-with-at-least-32-random-bytes
CAMPAIGN_IDENTITY_SECRET=replace-with-a-separate-random-secret
MASTER_ENCRYPTION_KEY=replace-with-a-32-byte-encryption-secret
AUTHORIZED_SIGNER_PRIVATE_KEY=replace-with-buy-authorization-signer-private-key
OPERATOR_ADDRESS=replace-with-operator-or-multisig-address

# Circle User-Controlled Wallets. Configure the same Gmail SMTP in Circle Console for OTP.
CIRCLE_API_KEY=replace-with-circle-api-key
CIRCLE_BASE_URL=https://api.circle.com
CIRCLE_MAX_APPROVAL_BASE_UNITS=1000000000

# GroupDeal transactional notifications through Gmail SMTP.
# Use a dedicated Google App Password, never the normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
SMTP_APP_PASSWORD=replace-with-16-character-google-app-password
SMTP_FROM=GroupDeal <your-address@gmail.com>

# Optional legacy HTTP provider fallback. Leave unset when Gmail SMTP is used.
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_TOKEN=

# Comma-separated frontend origins. Required in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
