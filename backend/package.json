{
  "name": "group-deal-backend",
  "version": "1.0.0",
  "description": "Backend API, Indexer and Reconciler for GroupDeal on Arc Testnet",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test:accounting": "tsx test/accounting.test.ts",
    "test:security": "tsx test/auth_security.test.ts",
    "test:services": "tsx test/services_audit.test.ts",
    "test:abi": "tsx test/abi_contract_sync.test.ts",
    "test:wallet": "tsx test/wallet_relay_security.test.ts && tsx test/wallet_challenge_replay.test.ts",
    "test:g1": "tsx test/gate_g1_verification.test.ts",
    "test:g3": "tsx test/gate_g3_verification.test.ts",
    "test": "tsx test/accounting.test.ts && tsx test/auth_security.test.ts && tsx test/services_audit.test.ts && tsx test/abi_contract_sync.test.ts && tsx test/wallet_relay_security.test.ts && tsx test/wallet_challenge_replay.test.ts && tsx test/gate_g1_verification.test.ts && tsx test/gate_g3_verification.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
