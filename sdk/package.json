{
  "name": "@groupdeal/sdk",
  "version": "2.0.0",
  "description": "GroupDeal Seller Integration SDK for Arc Testnet",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node test/consumer.cjs && node test/webhookEnvelope.cjs && node test/supportDownload.cjs",
    "test:webhook": "npm run build && node test/webhookEnvelope.cjs",
    "test:support-download": "npm run build && node test/supportDownload.cjs"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "5.9.3"
  },
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "examples/receiver.cjs"
  ],
  "engines": {
    "node": ">=22.13.0"
  }
}
